# Nunca versionar segredos. A chave publishable no supabaseClient.js e segura
# de expor; qualquer ficheiro .env com a chave secreta / service_role nao e.
.env
.env.*
*.key
*.pem

# Exportacoes de dados (ex: sql/migrate_assets.sql gera CSVs com dados reais
# para carregar na base -- nunca ficam versionados)
*.csv

# Sistema operativo e editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Dependencias (a app nao usa build, mas fica a rede de seguranca)
node_modules/
